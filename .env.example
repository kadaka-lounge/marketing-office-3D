# Optional. Leave blank to use demo mode and manual artifact editing.
# Secrets stay on the server. Never prefix these names with NEXT_PUBLIC_.
MARKETING_AI_KEY=
MARKETING_AI_MODEL=gpt-4.1-mini
MARKETING_AI_BASE_URL=https://api.openai.com/v1
# Backend & API settings override the endpoint/model without a restart.
# Environment keys are scoped to MARKETING_AI_BASE_URL.
# OPENAI_API_KEY is an alternative to MARKETING_AI_KEY.

# Optional separate OpenAI key for campaign image generation.
# Falls back to the enabled OpenAI design profile, then the global OpenAI key.
MARKETING_IMAGE_KEY=
MARKETING_IMAGE_MODEL=gpt-image-1

# Optional independent image providers; select one in Backend & API -> Model Gambar.
# Google AI Studio / Gemini API key, with Imagen access and billing.
GOOGLE_IMAGEN_KEY=
GOOGLE_IMAGEN_MODEL=imagen-3.0-generate-002
# HF user token (hf_) with Inference Providers permission and credits.
HF_IMAGE_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# SQLite, generated assets, backend settings, and encryption key; relative to repo.
# Keep the entire data directory private and persistent; never commit it.
OFFICE_DATA_DIR=.data

# Optional manager access token. Set before exposing the server to other users.
OFFICE_ACCESS_TOKEN=

# Optional generic publishing webhook. Sending requires an explicit action.
# Leave blank for local scheduling and export only.
MARKETING_PUBLISH_URL=
MARKETING_PUBLISH_TOKEN=

# Optional settings for npm run dev:local / npm run start:local.
# Copy the exact installed model name from ollama list. No model is downloaded.
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional independent division providers (also editable in Backend & API).
# An environment key enables its division provider unless explicitly disabled.
# Claude: Atlas/Nova + custom Data Analyst agents.
CLAUDE_API_KEY=
# Gemini: Luna + custom Graphic Design agents.
GEMINI_API_KEY=
# OpenAI: Pixel; also GPT Image. Separate from the global backend key.
DESIGN_OPENAI_KEY=
# Meta Graph (Facebook Login) account identity connection only, not an LLM key.
# Does not enable automatic/direct publication or connect TikTok.
META_GRAPH_TOKEN=

# Optional TikTok OAuth user access token with video.publish scope.
# Editable in Backend & API -> Publisher TikTok. Never use NEXT_PUBLIC_.
# Client key/secret alone cannot publish; renew the access token when expired.
TIKTOK_ACCESS_TOKEN=

# Optional video generation, separate from FLUX image credentials.
# Select a model in Backend & API -> Model Video. HF token needs Inference Providers.
HF_VIDEO_TOKEN=
HF_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B

# Optional Qwen Image GGUF server with OpenAI-compatible image generation API.
# Start the model runtime separately; Ollama text APIs cannot generate these images.
QWEN_IMAGE_BASE_URL=http://127.0.0.1:1234/v1
QWEN_IMAGE_MODEL=Qwen-Image-2.1-Uncensored-GGUF
QWEN_IMAGE_KEY=

# Optional native ComfyUI endpoints. Workflows are imported privately through the UI.
COMFY_IMAGE_BASE_URL=http://127.0.0.1:8188
COMFY_IMAGE_MODEL=Qwen-Image-2.1-Uncensored-GGUF
COMFY_IMAGE_KEY=
COMFY_VIDEO_BASE_URL=http://127.0.0.1:8188
COMFY_VIDEO_MODEL=ltx25_uncensored_v1.1-fp8
COMFY_VIDEO_KEY=
