{
  "name": "kadaka-marketing-office",
  "version": "1.0.0",
  "private": true,
  "description": "A human-led AI marketing office powered by Claw3D",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:local": "node scripts/local-llm.mjs dev",
    "start:local": "node scripts/local-llm.mjs start"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.5.0",
    "lucide-react": "0.563.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "three": "0.183.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.1.7",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
